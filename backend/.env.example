# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Lightweight embeddings via the OpenAI API (no local ML weights).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI-backed entailment classifier used by claim verification.
OPENAI_NLI_MODEL=gpt-5.6-luna

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Verification & Retrieval Settings
NLI_THRESHOLD=0.70
RETRIEVAL_K=5
CLAIM_RETRIEVAL_K=3

# --- Authentication ---
# AUTH_MODE=dev  -> trust the x-user-id header (LOCAL DEVELOPMENT ONLY)
# AUTH_MODE=prod -> require a valid Bearer JWT (verify signature, exp, iat, alg)
AUTH_MODE=dev
# Secret used to verify JWTs. For HS256 use a shared secret >= 32 chars.
# For RS256/ES256 (e.g. Clerk), set this to the PEM-encoded public key and add
# JWT_ALGORITHMS=RS256.
JWT_SECRET=
# Issuer/audience are validated when configured (recommended in production):
# JWT_ISSUER=
# JWT_AUDIENCE=
# Comma-separated list of accepted algorithms (default HS256,RS256,ES256).
# JWT_ALGORITHMS=HS256,RS256,ES256

# Optional: Custom data directory
# DATA_DIR=backend/data
